# ==========================================
# 🐍 DJANGO SETTINGS
# ==========================================
# 🔑 СЕКРЕТНЫЕ КЛЮЧИ (генерируются автоматически при first run)
SECRET_KEY={{SECRET_KEY}}
SIGNING_KEY={{SIGNING_KEY}}


# 🛠️ НАСТРОЙКИ РАЗРАБОТКИ (для портфолио оставляем True)
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_API_URL=http://django:8001
DJANGO_TIMEOUT=5

# ==========================================
# 🐘 POSTGRESQL
# ==========================================
POSTGRES_DB=logistics_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD={{POSTGRES_PASSWORD}}
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ==========================================
# 🚀 FASTAPI SETTINGS
# ==========================================
FASTAPI_SECRET_KEY={{FASTAPI_SECRET_KEY}}
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REDIS_URL=redis://redis-storage:6379/0

# ==========================================
# 📨 KAFKA
# ==========================================
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ==========================================
# 🌍 ОБЩИЕ НАСТРОЙКИ
# ==========================================
ENVIRONMENT=development

# ==========================================
# 🔧 ДЛЯ ПРОДАКШЕНА (закомментировано)
# ==========================================
# DEBUG=False
# ENVIRONMENT=production
# ALLOWED_HOSTS=your-domain.com,www.your-domain.com